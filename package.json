{
  "name": "atelier-halle-media-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Private, single-user, local-first photo post planner and scheduler for Instagram and Pinterest.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "build": "vite build",
    "start": "node src/server/main.ts",
    "open": "node scripts/open.ts",
    "backup": "node scripts/backup.ts",
    "service": "node scripts/service.ts",
    "dev": "MEDIA_MANAGER_ENV=development node --watch-path=src --watch-path=migrations src/server/main.ts",
    "dev:web": "vite build --watch --mode development",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/web/tsconfig.json",
    "lint": "oxlint --deny-warnings src tests scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run check:secrets && npm test",
    "test:e2e": "npm run build && playwright test",
    "audit:deps": "npm audit && npm audit signatures && npm install-scripts ls",
    "check:secrets": "node scripts/check-secrets.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/multipart": "10.1.6",
    "@fastify/static": "10.1.8",
    "@napi-rs/keyring": "2.1.2",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "oxlint": "1.90.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "better-sqlite3": false,
    "fsevents": false
  }
}
